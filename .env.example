# ---------- Backend ----------
APP_ENV=dev
DATABASE_URL=sqlite:///./data/shiftsync.db
CONFIG_DIR=../config
SCENARIO_PATH=../demo/scenario.json
EVAL_DIR=../eval/scenarios
BRIDGE_URL=http://localhost:8787
# Where the web app runs; the iMessage bridge links replies to {FRONTEND_URL}/create/{id}/review
FRONTEND_URL=http://localhost:5173
SITE_TIMEZONE=America/Chicago

# LLM: claude | nemotron   (per-task override: LLM_PROVIDER_EXTRACT, _CLARIFY, _BRIEF, _VERIFY_QUESTION, _GRADE)
LLM_PROVIDER=nemotron
ANTHROPIC_API_KEY=
# Leave model ids empty until you confirm them on the provider's current docs.
# The source pack named unverified examples; they are not copied here.
CLAUDE_MODEL=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=

# Speech-to-text: local | openai
STT_PROVIDER=local
OPENAI_API_KEY=
OPENAI_STT_MODEL=whisper-1
LOCAL_WHISPER_MODEL=small.en

# ---------- Optional P1: Photon bridge (photon-bridge/.env) ----------
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
BACKEND_URL=http://localhost:8000
BRIDGE_PORT=8787
