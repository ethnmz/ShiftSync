# Copy to photon-bridge/.env (git-ignored).
# Leave the Spectrum pair empty to use the terminal chat instead of iMessage.
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=
BACKEND_URL=http://localhost:8000

# Roster phones in config/roster.yaml are fictional. Map each real sender id to one,
# comma-separated: SENDER_MAP=+12145550123=+15550100001,me@icloud.com=+15550100004
# Real numbers stay in this file only. Never commit them.
SENDER_MAP=

# Terminal chat only: the roster phone the terminal speaks as (default Maya, night lead).
TERMINAL_SENDER_PHONE=+15550100001
